# Copy to .env. Never commit .env or put secrets in frontend variables.
DJANGO_SECRET_KEY=replace-this-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_NAME=heatshield_ai
DATABASE_USER=heatshield_dev
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
TIME_ZONE=Asia/Kolkata
MAX_OBSERVATION_AGE_DAYS=7
HISTORICAL_OBSERVATION_MAX_AGE_DAYS=365
WEATHER_DATA_PROVIDER=demo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_HSTS_SECONDS=0
